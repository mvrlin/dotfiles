{
  "auto_install_extensions": {
    "astro": true,
    "catppuccin": true,
    "dart": true,
    "golangci-lint": true,
    "html": true,
    "scss": true,
    "svelte": true,
    "toml": true,
    "vue": true,
    "xml": true,
  },
  "auto_update": false,
  "buffer_font_family": "JetBrains Mono NL",
  "buffer_font_size": 17.5,
  "buffer_line_height": {
    "custom": 1.6,
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "colorize_brackets": true,
  "confirm_quit": true,
  "cursor_blink": false,
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
    },
  },
  "diff_view_style": "unified",
  "disable_ai": true,
  "edit_predictions": {
    "provider": "none",
  },
  "file_scan_exclusions": ["**/*.meta"],
  "file_types": {
    "JSON": ["*.arb"],
  },
  "git_panel": {
    "dock": "right",
    "sort_by_path": false,
    "status_style": "label_color",
    "tree_view": false,
  },
  "gutter": {
    "runnables": false,
  },
  "inline_code_actions": false,
  "languages": {
    "Go": {
      "language_servers": ["gopls", "golangci-lint"],
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "formatter": [],
    },
    "JSON": {
      "format_on_save": "off",
    },
    "JSONC": {
      "language_servers": [],
    },
    "Rust": {
      "tab_size": 4,
    },
    "SCSS": {
      "format_on_save": "off",
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "formatter": [],
    },
    "Vue.js": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "formatter": [],
    },
    "XML": {
      "format_on_save": "off",
    },
    "YAML": {
      "format_on_save": "off",
    },
  },
  "lsp": {
    "dart": {
      "settings": {
        "lineLength": 100,
      },
    },
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path=",
        ],
      },
    },
    "vtsls": {
      "settings": {
        "javascript": {
          "tsserver": {
            "experimental": {},
            "maxTsServerMemory": 8092,
          },
        },
        "typescript": {
          "tsserver": {
            "experimental": {},
            "maxTsServerMemory": 16184,
          },
        },
      },
    },
  },
  "on_last_window_closed": "quit_app",
  "outline_panel": {
    "dock": "left",
  },
  "preview_tabs": {
    "enabled": false,
    "enable_keep_preview_on_code_navigation": false,
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 12,
  },
  "relative_line_numbers": "enabled",
  "show_whitespaces": "boundary",
  "soft_wrap": "none",
  "tab_size": 2,
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_close_button": "hidden",
    "show_diagnostics": "all",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "font_size": 17.5,
    "line_height": {
      "custom": 1.7,
    },
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "theme": "Catppuccin Mocha - No Italics",
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 21,
  "vim": {
    "use_system_clipboard": "never",
  },
  "vim_mode": true,
}

