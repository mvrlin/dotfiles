{
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "deepseek",
      "model": "deepseek-chat"
    }
  },
  "auto_install_extensions": {
    "astro": true,
    "dart": true,
    "fleet-themes": true,
    "html": true,
    "scss": true,
    "svelte": true,
    "toml": true,
    "vue": true,
    "xml": true
  },
  "auto_signature_help": true,
  "auto_update": false,
  "buffer_font_family": "JetBrains Mono NL",
  "buffer_font_size": 17.5,
  "buffer_line_height": {
    "custom": 1.6
  },
  "confirm_quit": true,
  "cursor_blink": false,
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true
    }
  },
  // https://github.com/skarline/zed-fleet-themes/pull/10
  "experimental.theme_overrides": {
    "players": [
      {
        "selection": "#A8C6F466"
      }
    ]
  },
  "features": {
    "edit_prediction_provider": "none"
  },
  "git_panel": {
    "dock": "right",
    "status_style": "label_color"
  },
  "gutter": {
    "runnables": false
  },
  "languages": {
    "JavaScript": {
      "formatter": {
        "code_actions": {
          "source.fixAll.eslint": true
        }
      }
    },
    "JSON": {
      "format_on_save": "off"
    },
    "Rust": {
      "tab_size": 4
    },
    "SCSS": {
      "format_on_save": "off"
    },
    "TypeScript": {
      "formatter": {
        "code_actions": {
          "source.fixAll.eslint": true
        }
      }
    },
    "Vue.js": {
      "formatter": {
        "code_actions": {
          "source.fixAll.eslint": true
        }
      }
    },
    "XML": {
      "format_on_save": "off"
    },
    "YAML": {
      "format_on_save": "off"
    }
  },
  "lsp": {
    "dart": {
      "settings": {
        "lineLength": 100
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "tsserver": {
            "experimental": {
              // "enableProjectDiagnostics": true
            }
          }
        }
      }
    }
  },
  "on_last_window_closed": "quit_app",
  "preview_tabs": {
    "enabled": false,
    "enable_preview_from_code_navigation": false
  },
  "project_panel": {
    "indent_size": 12
  },
  "relative_line_numbers": true,
  "soft_wrap": "none",
  "tab_size": 2,
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_close_button": "hidden",
    "show_diagnostics": "all"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "font_family": "JetBrains Mono NL"
  },
  "theme": "Fleet Light",
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 21,
  "vim": {
    "use_system_clipboard": "never"
  },
  "vim_mode": true,
  "wrap_guides": [80]
}
